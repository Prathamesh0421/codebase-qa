# Copy to .env and adjust. Never commit .env -- it is gitignored.
# All variables are prefixed CODEQA_ and validated at startup by config.py;
# an unknown variable is an error rather than a silent typo.

# ---------------------------------------------------------------- storage
CODEQA_DATABASE_URL=postgresql://codeqa:codeqa@localhost:5432/codeqa
CODEQA_REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------- embeddings
# local  = sentence-transformers, free and reproducible (dev, CI, evals)
# hosted = embedding API, small container (deployed)
CODEQA_EMBEDDING_PROVIDER=local
CODEQA_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Interpolated into DDL as vector(N). Changing it needs a new migration and a
# re-index; the migration runner refuses to start on a mismatch.
CODEQA_EMBEDDING_DIM=384

# ---------------------------------------------------------------- retrieval
# naive | hybrid | hybrid_graph -- all three stay runnable so the eval
# comparison is reproducible at any commit.
CODEQA_RETRIEVAL_STRATEGY=hybrid_graph
CODEQA_RETRIEVAL_TOP_K=10
CODEQA_GRAPH_MAX_DEPTH=2

# ---------------------------------------------------------------- llm
CODEQA_LLM_MODEL=gemini/gemini-2.0-flash
CODEQA_LLM_API_KEY=

# ---------------------------------------------------------------- observability
CODEQA_OTEL_ENDPOINT=http://localhost:4317
CODEQA_LOG_LEVEL=INFO
CODEQA_ENVIRONMENT=dev
